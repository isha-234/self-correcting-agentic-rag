# Groq — LLM agents
OPENAI_API_KEY=your_groq_key_here
OPENAI_BASE_URL=https://api.groq.com/openai/v1

MODEL_RETRIEVER=llama-3.1-8b-instant
MODEL_ANSWERER=llama-3.3-70b-versatile
MODEL_CRITIC=llama-3.1-8b-instant
MODEL_ORCHESTRATOR=llama-3.3-70b-versatile

# Fireworks AI — embeddings
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_BASE_URL=https://api.fireworks.ai/inference/v1
EMBEDDING_API_KEY=your_fireworks_key_here

# ChromaDB
CHROMA_COLLECTION=rag_collection
CHROMA_DIR=./chroma_db

# Pipeline settings
TOP_K=5
RETRIEVAL_SCORE_THRESHOLD=0.6
MAX_RETRIEVAL_ATTEMPTS=2
MAX_CRITIC_REVISIONS=1